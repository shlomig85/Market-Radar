# Market Radar configuration.
# Copy to .env and fill in. NEVER commit a filled-in .env.
# Every variable is prefixed MARKETRADAR_ and read by marketradar/config.py.

# --- environment ------------------------------------------------------
MARKETRADAR_ENVIRONMENT=development       # development | test | production
MARKETRADAR_DEBUG=false
MARKETRADAR_LOG_LEVEL=INFO
MARKETRADAR_LOG_FORMAT=json               # json | console

# --- database ---------------------------------------------------------
MARKETRADAR_DATABASE_URL=postgresql+psycopg://marketradar:marketradar@localhost:5432/marketradar
MARKETRADAR_TEST_DATABASE_URL=postgresql+psycopg://marketradar:marketradar@localhost:5432/marketradar_test
MARKETRADAR_DB_ECHO=false

# --- api --------------------------------------------------------------
MARKETRADAR_API_HOST=0.0.0.0
MARKETRADAR_API_PORT=8000
MARKETRADAR_CORS_ORIGINS=http://localhost:3000

# --- data providers ---------------------------------------------------
# A provider with no credentials resolves to UNAVAILABLE. It is never silently replaced
# with fabricated data: the affected score components are excluded and reported as missing.
# "feeds" subscribes to RSS/Atom from reliable publishers and is what lets the system
# discover a trend nobody told it about; "fixture" is the synthetic DEMO corpus.
MARKETRADAR_NEWS_PROVIDER=feeds           # feeds (real publishers) | fixture (synthetic DEMO corpus)
#
# ====================================================================
#  PUT YOUR EMAIL HERE. Nothing real is fetched until you do.
# ====================================================================
# Publishers block anonymous scrapers and the SEC requires a contact address under its
# fair-access policy, so both refuse to fetch rather than send an anonymous request. Set
# both to the same string, e.g. "Market Radar you@example.com".
MARKETRADAR_FEED_USER_AGENT=
# Optional. Empty means "use the built-in list of reliable publishers"; setting it REPLACES
# that list, because which sources are trustworthy is the operator's judgement, not ours.
# Pipe-separated so URLs survive:
#   key|name|publisher|url|SOURCE_TYPE|SOURCE_CLASS|quality[|fetch_article]
# MARKETRADAR_FEEDS=myblog|My Blog|Someone|https://blog.example/rss|SPECIALIST_PUBLICATION|INDUSTRY|65
MARKETRADAR_FEED_MAX_ITEMS=40
MARKETRADAR_FILINGS_PROVIDER=sec_edgar    # sec_edgar (real filings) | fixture
MARKETRADAR_MARKET_DATA_PROVIDER=unavailable
MARKETRADAR_COMPANY_PROVIDER=sec          # sec (~8,000 real registrants) | fixture

# Same string as MARKETRADAR_FEED_USER_AGENT above. Without it the SEC adapter refuses to
# make any request rather than sending an anonymous one.
MARKETRADAR_SEC_USER_AGENT=
MARKETRADAR_SEC_BASE_URL=https://data.sec.gov

# SSRF allowlist: outbound provider fetches must target one of these hosts over https.
MARKETRADAR_HTTP_ALLOWED_HOSTS=data.sec.gov,www.sec.gov

# --- llm (optional) ---------------------------------------------------
# With no key the Research Planner uses its deterministic strategy, which is recorded on
# the plan and shown in the UI. It is never presented as model-generated reasoning.
MARKETRADAR_ANTHROPIC_API_KEY=
MARKETRADAR_PLANNER_MODEL=claude-sonnet-5

# --- pipeline tuning --------------------------------------------------
MARKETRADAR_OBSERVATION_WINDOW_DAYS=30
MARKETRADAR_BASELINE_WINDOW_DAYS=90
MARKETRADAR_DUPLICATE_SIMILARITY_THRESHOLD=0.60

# --- frontend ---------------------------------------------------------
MARKETRADAR_API_URL=http://localhost:8000

# Terms you never want to see as a discovered subject. The rules cover categories — common
# English, verb forms, dates, publisher and company names — but cannot know that "Condé Nast"
# is Ars Technica's parent, or that a phrase is furniture on a site only you subscribe to.
# A term is excluded if it matches or CONTAINS any entry.
# MARKETRADAR_SUBJECT_EXCLUSIONS=cond nast,affiliate link,privacy policy
